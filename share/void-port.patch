+bindsym $mod+Escape exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-menu toggle system'
 
 # Lock Computer (Super + Ctrl + L)
 bindsym $mod+Ctrl+l exec swaylock -f -c 000000
 
 # Toggle Menu (Super + Ctrl + O)
-bindsym $mod+Ctrl+o exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-menu toggle trigger.toggle'
+bindsym $mod+Ctrl+o exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-menu toggle trigger.toggle'
 
 # --- TOGGLE MODES ---
 # Night Light (Super + Ctrl + N)
-bindsym $mod+Ctrl+n exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-nightlight'
+bindsym $mod+Ctrl+n exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-nightlight'
 
 # Silence Notifications (Super + Ctrl + ,)
-bindsym $mod+Ctrl+comma exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-notification-silencing'
+bindsym $mod+Ctrl+comma exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-notification-silencing'
 
 # Stay Awake (Idle Lock Disabled) (Super + Ctrl + I)
-bindsym $mod+Ctrl+i exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-idle'
+bindsym $mod+Ctrl+i exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-idle'
 
 # Top Bar (Super + Shift + Space)
-bindsym $mod+Shift+space exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-bar'
+bindsym $mod+Shift+space exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-bar'
 
 # --- HARDWARE MENUS & TOGGLES ---
 # Hardware Menu (Super + Ctrl + H)
-bindsym $mod+Ctrl+h exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-menu toggle trigger.hardware'
+bindsym $mod+Ctrl+h exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-menu toggle trigger.hardware'
 
 # Touchpad (XF86TouchpadToggle)
-bindsym XF86TouchpadToggle exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-touchpad'
+bindsym XF86TouchpadToggle exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-toggle-touchpad'
 
 # Dictation (Voxtype) - Hold F9 to dictate / Super + Ctrl + X to toggle
-bindsym F9 exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-voxtype-toggle start'
-bindsym --release F9 exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-voxtype-toggle stop'
-bindsym $mod+Ctrl+x exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-/usr/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-voxtype-toggle toggle'
+bindsym F9 exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-voxtype-toggle start'
+bindsym --release F9 exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-voxtype-toggle stop'
+bindsym $mod+Ctrl+x exec bash -c 'export MAGIKOS_PATH="${MAGIKOS_PATH:-$HOME/.local/share/magikos}"; export PATH="$MAGIKOS_PATH/bin:$PATH"; exec magikos-voxtype-toggle toggle'
 
 # Terminal Launcher
 bindsym $mod+Return exec foot
diff --git a/config/sway/environment.conf b/config/sway/environment.conf
index 3b28627ac024015279f9a3c048cd0fadd6409b92..b183127e61a3a45ba90c0bf01491dc0649918e9e 100644
--- a/config/sway/environment.conf
+++ b/config/sway/environment.conf
@@ -6,5 +6,10 @@
 # packaged tree location; plain sway sessions (ly -> sway.desktop) bypass uwsm,
 # so session code cannot assume MAGIKOS_PATH is present in the environment.
 # Dev checkouts override this file in ~/.config/sway/environment.conf.
-set $MAGIKOS_PATH /usr/share/magikos
-set $PATH /usr/share/magikos/bin:$HOME/.local/bin:$PATH
+set $MAGIKOS_PATH $HOME/.local/share/magikos
+set $PATH $HOME/.local/share/magikos/bin:$HOME/.local/bin:$PATH
+
+# AMD iGPU drives the display (card0 = Radeon Renoir, eDP-1).
+# NVIDIA dGPU is Prime-offload only: launch apps with `DRI_PRIME=1 <app>`
+# or use `prime-run` / `nvidia-offload` wrapper scripts.
+set $WLR_DRM_DEVICES /dev/dri/card0
